{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vibe-security",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "placement": {
    "region": "gcp:asia-northeast3"
  },
  "ratelimits": [
    {
      "name": "AI_LIMITER",
      "namespace_id": "8510251025",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
